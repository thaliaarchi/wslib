# pow returns x raised to the power of y, using exponentiation by
# squaring. If y <= 0, 1 is returned.
# (x y -- x**y)
pow:
    ^ 1  j< .pow_one  # y <= 0
.pow:
    ^ 1  j= .pow_x    # y == 1
    ^ 2% jz .pow_even # y%2 == 0
# .pow_odd:
    # pow(x**2, (y-1)/2) * x
    ^1 ^ * swap
    1- 2/
    call .pow
    *
    ret
.pow_even:
    # pow(x**2, y/2)
    swap ^ * swap
    2/
    jmp .pow
.pow_one:
    2drop 1 ret
.pow_x:
    drop ret

# TODO
# (x y m -- (x**y)%m)
modexp:
    -999 3slide ret

# tetrate returns the tetration of x and y, that is, y copies of x
# combined by exponentiation, right-to-left. If y <= 0, 1 is returned.
# (x y -- x^^y)
tetrate:
    1
.tetrate_loop:
    swap 1- swap
    ^1 jn .tetrate_done
    ^2 swap call pow
    jmp .tetrate_loop
.tetrate_done:
    2slide ret

# pentate returns the pentation of x and y, that is, y copies of x
# combined by tetration, right-to-left. If y <= 0, 1 is returned.
# (x y -- x^^^y)
pentate:
    1
.pentate_loop:
    swap 1- swap
    ^1 jn .pentate_done
    ^2 swap call tetrate
    jmp .pentate_loop
.pentate_done:
    2slide ret
